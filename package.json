{
  "name": "2nomads-backend",
  "version": "1.0.0",
  "description": "Backend API for 2NOMADS Transportation Design Studio & Academy",
  "main": "dist/server.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "test": "ts-node src/database/test-api.ts",
    "secret:generate": "node scripts/generate-keys.js",
    "secret:update-env": "node scripts/generate-keys.js --update-env",
    "db:migrate": "ts-node src/database/migrate.ts",
    "db:seed": "ts-node src/database/seed.ts",
    "db:setup": "ts-node src/database/migrate.ts && ts-node src/database/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "2nomads",
    "transportation-design",
    "express",
    "typescript",
    "sequelize",
    "postgresql"
  ],
  "author": "2NOMADS",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
