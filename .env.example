# Server Configuration
NODE_ENV=development
PORT=5050

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nomads_db
DB_USER=postgres
DB_PASSWORD=root
DB_LOGGING=false

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Admin Initial Seed Credentials
DEFAULT_ADMIN_EMAIL=admin@2nomads.design
DEFAULT_ADMIN_PASSWORD=AdminPassword123!
DEFAULT_ADMIN_NAME=R Donshong Koren (Admin)

# Email / SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="2NOMADS Studio & Academy" <admissions@2nomads.design>
SMTP_MOCK_MODE=true
ADMIN_NOTIFICATION_EMAIL=admin@2nomads.design

# WhatsApp Meta Cloud API Configuration
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_API_VERSION=v21.0
WHATSAPP_MOCK_MODE=true
