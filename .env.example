# Server Configuration
NODE_ENV=production
PORT=5050

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nomads_db
DB_USER=nomads_user
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD
DB_LOGGING=false

# Authentication & Security (generate with: npm run secret:generate)
JWT_SECRET=YOUR_64_CHAR_HEX_JWT_SECRET
JWT_EXPIRES_IN=7d
SESSION_SECRET=YOUR_64_CHAR_HEX_SESSION_SECRET
API_SECRET_KEY=YOUR_64_CHAR_HEX_API_KEY

# CORS Configuration
CORS_ORIGIN=https://2nomadstudio.com,https://www.2nomadstudio.com,http://localhost:4200

# Admin Initial Seed Credentials
DEFAULT_ADMIN_EMAIL=admin@2nomads.design
DEFAULT_ADMIN_PASSWORD=AdminPassword123!
DEFAULT_ADMIN_NAME=R Donshong Koren (Admin)

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="2NOMADS Studio & Academy" <admissions@2nomads.design>
SMTP_MOCK_MODE=true
ADMIN_NOTIFICATION_EMAIL=admin@2nomads.design

# WhatsApp Meta Cloud API Configuration
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_API_VERSION=v21.0
WHATSAPP_MOCK_MODE=true

